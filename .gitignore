# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# original project media archive
/public/assets/projects/

# misc
.DS_Store
._*
*.pem
*.tmp
*.temp
*.swp
*~
/.cache/
/tmp/
/temp/

